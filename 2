    try{return v=="groq"?await qem(p):await gem(p)}catch(e){err=e}
  }
  throw err||new Error("أدخل مفتاح Groq أو Gemini في «إعدادات الذكاء الاصطناعي».");
}
async function gbench(){
  var out=$("gbo"),res=[],PR='Return only JSON: {"nl":"huis","ar":"<Arabic translation>","en":"<English translation>","example":{"nl":"<short Dutch sentence>","ar":"<Arabic>","en":"<English>"}}';
  var jobs=[];
  if($("gq_i").value.trim()){
    try{localStorage.setItem("gq",$("gq_i").value.trim())}catch(e){}
    var ms=[];
    try{var l=await (await fetch("https://api.groq.com/openai/v1/models",{headers:{"Authorization":"Bearer "+gqkey()}})).json();
      ms=(l.data||[]).map(function(m){return m.id}).filter(function(id){return !/(whisper|tts|guard|orpheus|embed|compound|allam)/i.test(id)})}catch(e){}
    if(!ms.length)ms=GQS.map(function(m){return m[0]});
    var pf=function(x){return /oss|instant|flash|scout|llama/.test(x)?1:0};
    ms=ms.sort(function(a,b){return pf(b)-pf(a)}).slice(0,8);
    ms.forEach(function(m){jobs.push({v:"groq",m:m})});
  }
  if($("gk_i").value.trim()){
    try{localStorage.setItem("gk",$("gk_i").value.trim())}catch(e){}
    GMS.filter(function(m){return !/latest/.test(m[0])}).forEach(function(m){jobs.push({v:"gemini",m:m[0]})});
  }
  if(!jobs.length){out.innerHTML="أدخل مفتاح Groq أو Gemini أولًا.";return}
  function draw(extra){out.innerHTML=res.map(function(r){return (r.ok?"✓ ":"✗ ")+(r.v=="groq"?"Groq":"Gemini")+' <span dir="ltr">'+r.m+'</span> — '+(r.ok?(r.ms/1000).toFixed(1)+" ث":esc(r.err))}).join("<br>")+(extra||"<br>…")}
  out.innerHTML="جارٍ الاختبار… قد يستغرق دقيقة.";
  for(var i=0;i<jobs.length;i++){var jb=jobs[i],t=Date.now(),ok=false,er="";
    try{var x=jb.v=="groq"?await qcall(jb.m,PR):await gcall(jb.m,PR);
      if(x.r.ok){var o=jb.v=="groq"?qparse(x):gparse(x);ok=!!(o&&o.nl)}else er="HTTP "+x.r.status+((x.j&&x.j.error&&x.j.error.message)?" — "+x.j.error.message.slice(0,60):"")}
    catch(e){er=(e&&e.message)||"فشل الاتصال"}
    res.push({v:jb.v,m:jb.m,ok:ok,ms:Date.now()-t,err:er||"استجابة غير صالحة"});draw()}
  try{var qa=res.filter(function(r){return r.v=="groq"&&r.ok}).sort(function(a,b){return a.ms-b.ms}).map(function(r){return r.m});if(qa.length)localStorage.setItem("qav",JSON.stringify(qa))}catch(e){}
  var good=res.filter(function(r){return r.ok}).sort(function(a,b){return a.ms-b.ms});
  if(!good.length){draw("<br>لا نموذج استجاب. تحقق من المفاتيح.");return}
  var f=good[0];
  $("ap_s").value=f.v;if(f.v=="groq"){$("qm_s").innerHTML=mopts(qlist(),f.m);$("qm_s").value=f.m;$("qm_i").value=""}else{$("gm_s").value=f.m;$("gm_i").value=""}
  asave();
  draw('<br><b>الأسرع عندك: '+(f.v=="groq"?"Groq":"Gemini")+' <span dir="ltr">'+f.m+'</span> — '+(f.ms/1000).toFixed(1)+' ث. تم اعتماده وحفظه.</b>');
}

