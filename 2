  var pa=ik&&ik.past?ik.past+(wi&&wi.past&&wi.past!=ik.past?" / "+wi.past:""):"";var pp=c.past_part?(c.aux=="zijn"?"is ":c.aux=="hebben"?"heeft ":"")+c.past_part:"";return pa||pp?{pa:pa,pp:pp}:null}
