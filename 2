textarea{width:100%;min-height:90px;font:inherit;padding:10px;border-radius:10px;border:1px solid var(--bd);background:var(--card);color:var(--tx);margin:6px 0}
.row input{flex:1;margin:0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}
.tile{padding:14px 6px;min-height:56px;text-align:center}
.tile.sel{background:var(--ac2);border-color:var(--ac)}
.tile.done{opacity:.35}
.tile.bad{background:var(--bad);color:#fff}
.rate button{padding:10px 2px;font-size:.85rem}
.star{background:none;border:none;font-size:1.2rem;padding:0 6px;cursor:pointer}
.mini{padding:2px 10px;font-size:.8rem}
details{margin:8px 0}
</style>
