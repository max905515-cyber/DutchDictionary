  if(dup){if(stc&&!dup.star){dup.star=1;save();b.textContent="✓ موجودة، وأُضيفت إلى كلماتي";return}b.textContent="✓ موجودة بالفعل في «"+s.name+"»";return}
  var ex=e.ex||{},nc=mk([e.nl,e.article||"",e.type||"",e.ar||"",e.en||"",ex.nl||"",ex.ar||"",ex.en||"",e.note||""]);
  nc.pa=e.pa||"";nc.pp=e.pp||"";nc.star=stc?1:0;s.cards.push(nc);save();
