.item{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:10px 14px;margin-bottom:8px}
.item b{direction:ltr;unicode-bidi:isolate}
.opt{display:block;width:100%;text-align:right;margin-bottom:8px;padding:12px}
.opt.right{background:var(--ok);color:#fff}
.opt.wrong{background:var(--bad);color:#fff}
.big{font-size:2.2rem;direction:ltr;text-align:center;font-weight:700;margin:14px 0}
.bar{height:6px;background:var(--bd);border-radius:9px;overflow:hidden;margin-bottom:12px}
.bar i{display:block;height:100%;background:var(--ac)}
