function migrate(){
  var VF=VFM();
  var def={"الأسماء":"اسم","الأفعال":"فعل","الصفات":"صفة","العبارات":"عبارة","كلماتي":"*"};
  var main=DB.sets.filter(function(x){return x.main})[0];
  if(!main){
    main={id:uid(),name:"الكلمات",main:1,cards:[]};var keep=[],idx={};
    DB.sets.slice().sort(function(a,b){return (a.name=="كلماتي")-(b.name=="كلماتي")}).forEach(function(st){
      if(def[st.name]!==undefined){
        st.cards.forEach(function(c){var k=norm(c.nl),im=st.name=="كلماتي"||st.mine;
          if(idx[k]){if(im)idx[k].star=1;return}
          if(!c.ty&&!im)c.ty=def[st.name];if(im)c.star=1;idx[k]=c;main.cards.push(c)});
      }else keep.push(st);
    });
    DB.sets=[main].concat(keep);
  }
  DB.sets.forEach(function(st){delete st.mine;st.cards.forEach(function(c){if(c.ty===undefined)c.ty="";if(VF[c.nl]&&!c.pa){c.pa=VF[c.nl][0];c.pp=VF[c.nl][1];if(/^الماضي التام/.test(c.note||""))c.note=""}})});
}
